{
    "name": "colorways",
    "version": "0.2.5",
    "publisher": "Franthormel",
    "scripts": {
        "package": "vsce package -o colorways.vsix",
        "install": "code --install-extension colorways.vsix",
        "package-install": "vsce package -o colorways.vsix && code --install-extension colorways.vsix"
    },
    "engines": {
        "vscode": "^1.68.0"
    },
    "license": "SEE LICENSE.md",
    "displayName": "Colorways Themes",
    "description": "Themes inspired by Firefox Colorways.",
    "categories": [
        "Themes"
    ],
    "keywords": [
        "Themes",
        "Light",
        "Dark",
        "Balanced",
        "Colorways"
    ],
    "author": {
        "name": "Francis Anthony Carmel",
        "email": "fcaboyo@gmail.com",
        "url": "https://franthormel.github.io"
    },
    "icon": "assets/icon.png",
    "galleryBanner": {
        "color": "#FEFEFE",
        "theme": "light"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/franthormel/colorways-themes"
    },
    "homepage": "https://github.com/franthormel/colorways-themes",
    "bugs": {
        "url": "https://github.com/franthormel/colorways-themes/issues/new?template=bug_report.md&title=[BUG]"
    },
    "contributes": {
        "themes": [
            {
                "label": "Colorways - Cheers (Balanced)",
                "uiTheme": "vs",
                "path": "./themes/cheers/balanced-color-theme.json"
            },
            {
                "label": "Colorways - Cheers (Bold)",
                "uiTheme": "vs-dark",
                "path": "./themes/cheers/bold-color-theme.json"
            }
        ]
    },
    "devDependencies": {
        "vsce": "^4.0.0"
    }
}